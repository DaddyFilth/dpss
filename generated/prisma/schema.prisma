// Security-first database schema for AI dropshipping site

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

// User model with security fields
model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  password         String // Hashed password
  image            String?
  role             Role      @default(CUSTOMER)
  stripeCustomerId String? // Stripe customer ID for payments
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLogin        DateTime?

  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  cart           Cart?
  reviews        Review[]
  wishlist       WishlistItem[]
  socialAccounts SocialAccount[]

  @@index([email])
  @@index([role])
  @@index([stripeCustomerId])
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Social accounts for multi-platform posting
model SocialAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String // google, facebook, instagram, twitter, pinterest
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  profile           Json? // Store profile data
  expiresAt         DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialPosts SocialPost[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

// Social media posts for products
enum SocialPostStatus {
  SCHEDULED
  POSTED
  FAILED
  PENDING
}

model SocialPost {
  id          String           @id @default(cuid())
  productId   String
  accountId   String
  platform    String // instagram, facebook, twitter, pinterest
  content     String
  imageUrl    String? // Post image URL
  status      SocialPostStatus @default(PENDING)
  externalId  String? // Platform's post ID
  metrics     Json? // Engagement metrics (likes, shares, etc.)
  scheduledAt DateTime?
  postedAt    DateTime?
  error       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([accountId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
}

// Product catalog
model Product {
  id           String   @id @default(cuid())
  name         String
  description  String
  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  image        String
  images       String[] // Array of image URLs
  category     String
  tags         String[]
  stock        Int      @default(0)
  sku          String?  @unique
  featured     Boolean  @default(false)
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  aiScore      Float? // AI recommendation score
  aiTags       String[] // AI-generated tags

  // Customization support
  customizable        Boolean @default(false)
  customizationConfig Json? // Configuration for customization options (text, images, etc.)

  categoryId       String?
  printingSourceId String?
  printingSource   PrintingSource? @relation(fields: [printingSourceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems      OrderItem[]
  reviews         Review[]
  wishlist        WishlistItem[]
  cartItems       CartItem[]
  customizations  ProductCustomization[]
  socialPosts     SocialPost[]
  productCategory ProductCategory?       @relation("CategoryProducts", fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([featured])
  @@index([sku])
  @@index([customizable])
  @@index([printingSourceId])
}

// Shopping cart
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Orders
model Order {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  total         Decimal       @db.Decimal(10, 2)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  shipping      Decimal       @db.Decimal(10, 2)
  paymentMethod String
  paymentId     String? // Stripe/PayPal payment ID
  paymentStatus PaymentStatus @default(PENDING)

  // Shipping address
  shippingName    String
  shippingEmail   String
  shippingPhone   String?
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingZip     String
  shippingCountry String

  trackingNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  // Customization data
  customizationData Json? // Store user's custom design/text/images
  customizationCost Decimal @default(0) @db.Decimal(10, 2)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  printOrder PrintOrder?

  @@index([orderId])
  @@index([productId])
}

// Reviews
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String
  verified  Boolean  @default(false) // Verified purchase
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([rating])
}

// Wishlist
model WishlistItem {
  id        String   @id @default(cuid())
  productId String
  userId    String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
}

// Security audit log
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Printing sources (dropshipping printing partners)
enum PrintSourceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum PrintSourceProvider {
  PRINTFUL
  GOOTEN
  PRINTIFY
  CUSTOM
  LOCAL
}

model PrintingSource {
  id        String              @id @default(cuid())
  name      String
  apiKey    String? // API key for the service
  apiSecret String? // API secret for the service
  provider  PrintSourceProvider
  status    PrintSourceStatus   @default(ACTIVE)

  // API configuration
  apiUrl     String?
  webhookUrl String?

  // Pricing configuration
  basePrice Decimal? @db.Decimal(10, 2)
  markup    Decimal? @default(0) @db.Decimal(10, 2)

  // Production times
  productionDays Int @default(3)
  shippingDays   Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  printOrders PrintOrder[]

  @@index([provider])
  @@index([status])
}

// Product customization templates
model ProductCustomization {
  id        String @id @default(cuid())
  productId String
  name      String
  type      String // "text", "image", "color", "size", etc.

  // Customization options
  options  Json? // Array of available options
  required Boolean  @default(false)
  maxChars Int? // For text fields
  maxFiles Int? // For image uploads
  price    Decimal? @db.Decimal(10, 2) // Additional cost for customization

  // Template design
  template     Json? // Design template/config
  previewImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@index([type])
}

// Print orders sent to printing sources
enum PrintOrderStatus {
  PENDING
  PROCESSING
  PRINTED
  SHIPPED
  FAILED
  CANCELLED
}

model PrintOrder {
  id               String         @id @default(cuid())
  orderItemId      String         @unique
  printingSourceId String
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  printingSource   PrintingSource @relation(fields: [printingSourceId], references: [id])

  // Print order data
  printFileUrl String? // URL of the print-ready file
  printSpecs   Json? // Print specifications (size, material, etc.)

  // Status tracking
  status            PrintOrderStatus @default(PENDING)
  trackingNumber    String?
  estimatedDelivery DateTime?

  // Error handling
  errorMessage String?
  retryCount   Int       @default(0)
  lastRetryAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderItemId])
  @@index([printingSourceId])
  @@index([status])
}

// Newsletter subscriptions for marketing
model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String? // Where they subscribed (homepage, checkout, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

// Product categories for better organization
model ProductCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  parentId    String?
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]         @relation("CategoryProducts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([parentId])
}

// Coupon codes for discounts and promotions
enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CouponStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

model CouponCode {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  type           CouponType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  status         CouponStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([code])
  @@index([status])
  @@index([expiresAt])
}

// Analytics events for tracking user behavior
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String // page_view, add_to_cart, purchase, etc.
  eventData Json? // Flexible event data
  sessionId String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@index([sessionId])
}
