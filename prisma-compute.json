{
  "name": "dropship-ai",
  "version": "1.0.0",
  "build": {
    "command": "npm run build",
    "outputDirectory": ".next"
  },
  "start": {
    "command": "npm start"
  },
  "env": {
    "NODE_ENV": "production"
  },
  "database": {
    "prismaSchema": "prisma/schema.prisma",
    "migrate": true
  },
  "dependencies": {
    "node": "20"
  },
  "resources": {
    "cpu": "1",
    "memory": "1GB"
  }
}
